<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvPhoneUiDisplayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="虚拟屏幕接管模式"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <com.ai.assistance.showerclient.ui.ShowerSurfaceView
        android:id="@+id/viewPhoneUiDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="虚拟屏幕画面，可以点击或滑动进行接管操作"
        android:focusable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPhoneUiDisplayResume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="继续智能体任务" />

        <Button
            android:id="@+id/btnPhoneUiDisplayClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="关闭虚拟屏幕" />
    </LinearLayout>

</LinearLayout>
